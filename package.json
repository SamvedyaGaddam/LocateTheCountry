{
  "name": "geoquest",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack geography game with geospatial scoring and player analytics.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:setup": "node scripts/setup-db.js",
    "sync:metadata": "node scripts/sync-country-metadata.js",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "download:geometry": "node scripts/download-country-geometry.js"
  },
  "dependencies": {
    "@turf/turf": "^7.2.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "pg": "^8.13.1",
    "zod": "^4.6.7"
  }
}
